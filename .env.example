# Copie para backend/.env e preencha. NUNCA commite o .env real.

# ── Supabase (Project Settings → API) ─────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chave secreta (service_role) — uso exclusivo do backend, NUNCA frontend
SUPABASE_SECRET_KEY=

# ── Google OAuth (Google Cloud Console → APIs & Services → Credentials) ──
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Deve ser IDÊNTICO ao redirect URI cadastrado no cliente OAuth
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/gmail/callback

# ── Segurança ──────────────────────────────────────────────────────
# Chave Fernet (criptografia dos tokens Gmail no banco). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# String longa e aleatória (assinatura do 'state' anti-CSRF). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OAUTH_STATE_SECRET=

# ── App ────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
